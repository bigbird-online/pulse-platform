    { "id": "node-a" },
    { "id": "node-b" }
  ],
  "agents": [
    { "id": "agent-a", "placements": ["node-a", "node-b"], "ownerIds": ["agent-a"], "deliveryBotId": "agent-a-bot" }
  ],
