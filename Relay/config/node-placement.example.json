    }
  ],
  "bindings": [
    { "id": "example-user-agent-a", "activeNode": "node-a" }
  ],
  "jobs": [
    { "id": "agent-a-daily", "ownerId": "agent-a", "runNode": "node-b" }
  ],
  "userDefaults": [
    { "userId": "example-user", "nodeId": "node-a", "botId": "agent-a-bot" }
  ]
