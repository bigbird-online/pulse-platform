{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.local/schemas/node-placement-v1.json",
  "title": "PULSE node placement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentId", "status", "nodes", "agents", "bots", "bindings", "jobs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["candidate", "active"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "placements", "ownerIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "placements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "ownerIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "deliveryBotId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "bots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "agentId", "activeNode", "credentialRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "agentId": { "$ref": "#/$defs/id" },
          "activeNode": { "$ref": "#/$defs/id" },
          "credentialRefs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^env:[A-Z][A-Z0-9_]*$" }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "activeNode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "activeNode": { "$ref": "#/$defs/id" }
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ownerId", "runNode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ownerId": { "$ref": "#/$defs/id" },
          "runNode": { "$ref": "#/$defs/id" }
        }
      }
    },
    "userDefaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "nodeId", "botId"],
        "properties": {
          "userId": { "$ref": "#/$defs/id" },
          "nodeId": { "$ref": "#/$defs/id" },
          "botId": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
