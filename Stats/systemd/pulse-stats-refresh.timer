# Wakes the publisher every 120 s; the cycle itself starts only when the
# published snapshot would expire first (refresh_due). A wake-up while a
# cycle runs finds the oneshot service active and does nothing.
[Unit]
Description=PULSE Stats cost publisher tick

[Timer]
OnBootSec=2min
OnActiveSec=1min
OnUnitInactiveSec=120s
AccuracySec=10s

[Install]
WantedBy=timers.target
